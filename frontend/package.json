    "test:prediction-week": "node --test src/lib/predictions/week.test.mjs",
    "test:prediction-submit": "node --test src/lib/predictions/submit.test.mjs",
    "test:prediction-result": "node --test src/lib/predictions/result.test.mjs",
    "test:rating": "node --test src/lib/polls/rating.test.mjs",
    "test:vote-eligibility": "node --test src/lib/polls/vote-eligibility.test.mjs",
