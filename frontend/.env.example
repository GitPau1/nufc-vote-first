# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local auth testing
# Set to true only when you want cookie-based mock auth locally.
NEXT_PUBLIC_ENABLE_DEV_MOCK_AUTH=false

# Analytics (optional)
NEXT_PUBLIC_MIXPANEL_TOKEN=

# Admin
ADMIN_EMAILS=your-email@gmail.com

# Cache revalidation
REVALIDATE_SECRET=

# 예측 화면 "경기 통찰력" 문장 생성 (optional — 없으면 카드만 안 뜬다)
# https://aistudio.google.com/apikey 에서 발급, 무료 티어로 충분하다(주 1회 호출).
GEMINI_API_KEY=
